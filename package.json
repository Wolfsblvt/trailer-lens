{
  "name": "trailer-lens",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that makes Git commit trailers readable on GitHub commit pages.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "node --test \"tests/trailers/*.test.ts\" \"tests/settings/*.test.ts\" \"tests/assets/*.test.ts\"",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:browser && npm run package && npm run verify:package && npm run test:package",
    "oracle:generate": "node scripts/generate-git-oracles.mjs",
    "build": "node scripts/build.mjs",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.ts\"",
    "package": "node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:package": "node --test \"tests/package/*.test.ts\"",
    "assets:generate": "node scripts/generate-assets.mjs",
    "screenshots:generate": "node scripts/generate-screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/chrome": "0.2.6",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
